# GitScribe works without any of these: the offline engine needs no key.
# Set them only to use an OpenAI-compatible model. Never commit real values.
# You can also save them with: gitscribe config set api-key=...

# Base URL of any OpenAI-compatible API (OpenAI, OpenRouter, Groq, a local Ollama or LM Studio server)
GITSCRIBE_BASE_URL=https://api.openai.com/v1
GITSCRIBE_MODEL=gpt-4o-mini
GITSCRIBE_API_KEY=
